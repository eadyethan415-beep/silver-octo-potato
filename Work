-- Helper to quickly generate buy entries into our menu
local function createShopItem(name, cost, layoutOrder)
	local itemBtn = Instance.new("TextButton")
	itemBtn.Size = UDim2.new(0, 240, 0, 50)
	itemBtn.Text = name .. " (" .. cost .. " Coins)"
	itemBtn.Font = Enum.Font.FredokaOne
	itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	itemBtn.BackgroundColor3 = Color3.fromRGB(45, 180, 100)
	itemBtn.TextSize = 14
	itemBtn.LayoutOrder = layoutOrder
	itemBtn.Parent = ShopPanel
	Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 8)
	
	itemBtn.MouseButton1Click:Connect(function()
		-- Fire to server using secure Remote Functions
		local success = BuyGumEvent:InvokeServer(name)
		if success then
			itemBtn.Text = name .. " (OWNED)"
			itemBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
		else
			itemBtn.Text = "NOT ENOUGH COINS!"
			task.wait(1)
			itemBtn.Text = name .. " (" .. cost .. " Coins)"
		end
	end)
end

-- Generate list items to buy inside UI
createShopItem("Strawberry Burst", 50, 1)
createShopItem("Grape Fusion", 250, 2)
createShopItem("Hyper Neon", 1000, 3)

-- 2. Detect global click actions anywhere across game windows to blow gum bubble
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Ignore clicks if the player is typing inside text chat or shop buttons
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		-- Fire the request safely up to the server
		ChewEvent:FireServer()
	end
end)
