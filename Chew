-- Premium High-Fidelity UI Styling Toolkit
local function applyNeonStroke(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(0, 255, 200)
	stroke.Thickness = thickness or 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

local function applyRounding(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 16)
	corner.Parent = parent
end

local function applyPremiumGradient(parent, keypoints)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(keypoints)
	gradient.Rotation = 45
	gradient.Parent = parent
end

local function createPolishedButtonJuice(button, primaryColor, secondaryColor)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = UDim2.new(0, button.Size.X.Offset + 6, 0, button.Size.Y.Offset + 6)}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = UDim2.new(0, button.Size.X.Offset - 6, 0, button.Size.Y.Offset - 6)}):Play()
	end)
	button.MouseButton1Down:Connect(function()
		button.Rotation = 4
		TweenService:Create(button, TweenInfo.new(0.05, Enum.EasingStyle.Quad), {ImageColor3 = Color3.fromRGB(200, 200, 200)}):Play()
	end)
	button.MouseButton1Up:Connect(function()
		button.Rotation = 0
		TweenService:Create(button, TweenInfo.new(0.05, Enum.EasingStyle.Quad), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	end)
end

