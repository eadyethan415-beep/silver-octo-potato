-- Efficient dynamic layout assembler loading the 100 variations generated by the server
local itemsData = CatalogFolder:GetChildren()
table.sort(itemsData, function(a, b)
	return (a:FindFirstChild("Cost") and a.Cost.Value or 0) < (b:FindFirstChild("Cost") and b.Cost.Value or 0)
end)

for _, folder in ipairs(itemsData) do
	local name = folder.Name
	local cost = folder.Cost.Value
	local mult = folder.Multiplier.Value
	local color = folder.Color.Value

	local row = Instance.new("Frame", ScrollFrame)
	row.Size = UDim2.new(1, -10, 0, 65)
	row.BackgroundColor3 = Color3.fromRGB(20, 21, 30)
