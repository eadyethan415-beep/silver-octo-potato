	info.TextXAlignment = Enum.TextXAlignment.Left

	local buy = Instance.new("TextButton", row)
	buy.Size = UDim2.new(0.28, 0, 0.65, 0)
	buy.Position = UDim2.new(0.69, 0, 0.175, 0)
	buy.Text = "BUY"
	buy.Font = Enum.Font.FredokaOne
	buy.TextColor3 = Color3.fromRGB(255, 255, 255)
	buy.BackgroundColor3 = Color3.fromRGB(0, 200, 115)
	applyRounding(buy, 10)

	buy.MouseButton1Click:Connect(function()
		local ok = BuyGumEvent:InvokeServer(name)
		if ok then
			buy.Text = "EQUIPPED"
			buy.BackgroundColor3 = Color3.fromRGB(70, 75, 85)
		else
			buy.Text = "POOR!"
			buy.BackgroundColor3 = Color3.fromRGB(230, 50, 80)
			task.wait(0.7)
			buy.Text = "BUY"
			buy.BackgroundColor3 = Color3.fromRGB(0, 200, 115)
		end
	end)
end
