-- Server Script inside ServerScriptService
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

-- Ensure Remote Events exist
local ChewEvent = ReplicatedStorage:FindFirstChild("ChewEvent") or Instance.new("RemoteEvent", ReplicatedStorage)
ChewEvent.Name = "ChewEvent"

local BuyGumEvent = ReplicatedStorage:FindFirstChild("BuyGumEvent") or Instance.new("RemoteFunction", ReplicatedStorage)
BuyGumEvent.Name = "BuyGumEvent"

local RebirthEvent = ReplicatedStorage:FindFirstChild("RebirthEvent") or Instance.new("RemoteFunction", ReplicatedStorage)
RebirthEvent.Name = "RebirthEvent"

-- Database of upgradable gums [Name] = {Cost, SpeedMultiplier, Color}
local GumUpgrades = {
	["Blueberry Pop"] = {Cost = 0, Multiplier = 1, Color = Color3.fromRGB(85, 170, 255)},
	["Strawberry Burst"] = {Cost = 50, Multiplier = 2, Color = Color3.fromRGB(255, 85, 127)},
	["Grape Fusion"] = {Cost = 250, Multiplier = 5, Color = Color3.fromRGB(170, 85, 255)},
	["Hyper Neon"] = {Cost = 1000, Multiplier = 12, Color = Color3.fromRGB(85, 255, 127)}
}

Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder", player)
	leaderstats.Name = "leaderstats"

	local coins = Instance.new("IntValue", leaderstats)
	coins.Name = "Coins"
	coins.Value = 0

	local rebirths = Instance.new("IntValue", leaderstats)
	rebirths.Name = "Rebirths"
	rebirths.Value = 0

	local chews = Instance.new("IntValue", player)
	chews.Name = "Chews"
	chews.Value = 0

	local currentGum = Instance.new("StringValue", player)
	currentGum.Name = "CurrentGum"
	currentGum.Value = "Blueberry Pop"
	
	local speedMult = Instance.new("NumberValue", player)
	speedMult.Name = "SpeedMultiplier"
	speedMult.Value = 1
end)

-- FE Function: Player clicks to blow bubble gum
ChewEvent.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character or not character:FindFirstChild("Head") then return end
	
	local multiplier = player.SpeedMultiplier.Value
	local rebirthMultiplier = player.leaderstats.Rebirths.Value + 1
	
	-- Increment stats based on multipliers
	player.Chews.Value = player.Chews.Value + (1 * multiplier * rebirthMultiplier)
	player.leaderstats.Coins.Value = player.leaderstats.Coins.Value + (2 * multiplier * rebirthMultiplier)

	-- FE Visual 3D Physical Bubble Creation
	local head = character.Head
	local existingBubble = head:FindFirstChild("GumBubble")
	if existingBubble then existingBubble:Destroy() end

	local bubble = Instance.new("Part")
	bubble.Name = "GumBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Material = Enum.Material.Glass
	bubble.Transparency = 0.25
	bubble.CanCollide = false
	bubble.Massless = true
	
	local gumType = player.CurrentGum.Value
	bubble.Color = GumUpgrades[gumType] and GumUpgrades[gumType].Color or Color3.fromRGB(255, 170, 255)
	
	local weld = Instance.new("WeldConstraint")
	bubble.Position = head.Position + (head.CFrame.LookVector * 0.7)
	bubble.Size = Vector3.new(0.1, 0.1, 0.1)
	bubble.Parent = head
	
	weld.Part0 = head
	weld.Part1 = bubble
	weld.Parent = bubble

	-- Math equation scaling bubble outward size based on their active score
	local calculatedScale = math.clamp((player.Chews.Value * 0.04), 0.4, 4.5)
	
	-- Randomized Easter Egg: Rare Chance it turns into a giant head bubble overlaying ears
	local rand = math.random(1, 10)
	if rand == 7 then
		calculatedScale = 6.0
		bubble.Position = head.Position -- Moves bubble directly over the center head structure
	end

	local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local growTween = TweenService:Create(bubble, tweenInfo, {Size = Vector3.new(calculatedScale, calculatedScale, calculatedScale)})
	growTween:Play()
	
	task.delay(0.35, function()
		if bubble and bubble.Parent then bubble:Destroy() end
	end)
end)

-- FE Function: Store Shop Upgrade Validation
BuyGumEvent.OnServerInvoke = function(player, requestedGum)
	local coins = player.leaderstats.Coins
	local gumData = GumUpgrades[requestedGum]
	
	if gumData and coins.Value >= gumData.Cost then
		coins.Value = coins.Value - gumData.Cost
		player.CurrentGum.Value = requestedGum
		player.SpeedMultiplier.Value = gumData.Multiplier
		return true
	end
	return false
end

-- FE Function: Rebirth Calculation System
RebirthEvent.OnServerInvoke = function(player)
	local chews = player.Chews
	local currentRebirths = player.leaderstats.Rebirths
	local costToRebirth = (currentRebirths.Value + 1) * 500 -- Base multiplier scale cost
	
	if chews.Value >= costToRebirth then
		chews.Value = 0 -- Reset active chews bar baseline
		currentRebirths.Value = currentRebirths.Value + 1
		player.leaderstats.Coins.Value = 0 -- Reset currency baseline for progression loop
		player.CurrentGum.Value = "Blueberry Pop"
		player.SpeedMultiplier.Value = 1
		return true
	end
	return false
end
