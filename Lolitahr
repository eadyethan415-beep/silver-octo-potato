-- 2. DYNAMIC POPPING POPUP TEXT EFFECT
-- ==========================================
local function triggerGreatPopup()
	local popup = Instance.new("TextLabel")
	popup.Size = UDim2.new(0, 200, 0, 50)
	-- Random placement around center zone
	popup.Position = UDim2.new(0.5, math.random(-150, 50), 0.4, math.random(-80, 80))
	popup.BackgroundTransparency = 1
	popup.Text = "GREAT!"
	popup.Font = Enum.Font.FredokaOne
	popup.TextSize = 34
	popup.TextColor3 = Color3.fromRGB(255, 235, 60)
	popup.Parent = ScreenGui
	applyGlowBorder(popup, Color3.fromRGB(0,0,0), 3)

	-- Floating Zoom Effect
	popup:TweenSizeAndPosition(
		UDim2.new(0, 240, 0, 60),
		popup.Position - UDim2.new(0, 0, 0, 60),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Back,
		0.3,
		true
	)
	
	task.delay(0.35, function()
		popup:Destroy()
	end)
end

