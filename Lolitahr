-- Modern Clean Styling Helper Functions
local function applyGlowBorder(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(0, 210, 255)
	stroke.Thickness = thickness or 2.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
end

local function addSmoothRounding(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 14)
	corner.Parent = parent
end

local function applyLinearGradient(parent, colorsTable)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(colorsTable)
	gradient.Rotation = 45
	gradient.Parent = parent
end

