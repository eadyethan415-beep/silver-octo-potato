-- Helper function to generate premium rows in shop
local function addUpgradeRow(name, cost)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -5, 0, 60)
	row.BackgroundColor3 = Color3.fromRGB(22, 24, 35)
	row.Parent = Container
	addSmoothRounding(row, 10)
	applyGlowBorder(row, Color3.fromRGB(40, 45, 65), 1.5)
	
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.6, 0, 1, 0)
	lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.Text = name .. "\nCost: " .. cost
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	lbl.Parent = row

	local buy = Instance.new("TextButton")
	buy.Size = UDim2.new(0.35, 0, 0.7, 0)
	buy.Position = UDim2.new(0.62, 0, 0.15, 0)
	buy.Text = "BUY"
	buy.Font = Enum.Font.FredokaOne
	buy.TextColor3 = Color3.fromRGB(255, 255, 255)
	buy.BackgroundColor3 = Color3.fromRGB(0, 190, 110)
	buy.Parent = row
	addSmoothRounding(buy, 8)

	buy.MouseButton1Click:Connect(function()
		local success = BuyGumEvent:InvokeServer(name)
		if success then
			buy.Text = "EQUIPPED"
			buy.BackgroundColor3 = Color3.fromRGB(60, 65, 75)
		else
			buy.Text = "ERROR"
			task.wait(0.8)
			buy.Text = "BUY"
		end
	end)
end

addUpgradeRow("Strawberry Burst", 50)
addUpgradeRow("Grape Fusion", 250)
addUpgradeRow("Hyper Neon", 1000)

-- ==========================================
-- 5. FUNCTIONAL LOOPS & CLICK TRACKERS
-- ==========================================
ShopBtn.MouseButton1Click:Connect(function() ShopPanel.Visible = not ShopPanel.Visible end)

RebirthBtn.MouseButton1Click:Connect(function()
	local success = RebirthEvent:InvokeServer()
	if success then
		triggerGreatPopup()
	end
end)

-- Detect Global Screen Taps
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		ChewEvent:FireServer()
		if math.random(1, 4) == 2 then
			triggerGreatPopup() -- 25% chance of spawning pop-up feedback message text on click
		end
	end
end)

-- Real-time Progression Interface Tracker Bar Loop
task.spawn(function()
	while task.wait(0.1) do
		local chewsVal = LocalPlayer:FindFirstChild("Chews") and LocalPlayer.Chews.Value or 0
		local rebirthsVal = LocalPlayer.leaderstats:FindFirstChild("Rebirths") and LocalPlayer.leaderstats.Rebirths.Value or 0
		
		local nextTargetCost = (rebirthsVal + 1) * 500
		ProgressText.Text = "Chews Needed for Rebirth: " .. chewsVal .. " / " .. nextTargetCost
		
		-- Smoothly update progression bar scale
		local pct = math.clamp(chewsVal / nextTargetCost, 0, 1)
		TweenService:Create(ProgressBar, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
	end
end)
